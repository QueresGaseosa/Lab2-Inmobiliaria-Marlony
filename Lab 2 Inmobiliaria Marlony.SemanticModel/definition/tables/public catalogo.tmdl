		lineageTag: 14de84b8-6e3a-4563-8c9f-66ade87d2bf9
		summarizeBy: none
		sourceColumn: precio_lista

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'public catalogo' = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database("ep-wandering-wildflower-bdo482tz-pooler.c-8.us-east-2.aws.neon.tech:5432", "inmobiliaria"),
				    public_catalogo = Origen{[Schema="public",Item="catalogo"]}[Data],
				    #"Filas filtradas" = Table.SelectRows(public_catalogo, each ([nombre] <> null and [nombre] <> "   " and [nombre] <> "N/A" and [nombre] <> "Prodcto mal escrto"))
				in
				    #"Filas filtradas"

