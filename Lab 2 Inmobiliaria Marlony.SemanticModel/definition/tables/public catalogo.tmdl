table 'public catalogo'
	lineageTag: b114fe4c-0be2-4af5-93a0-81af3aa4dfe7

	measure 'Importe neto' =
			
			SUMX(
			    'public detalle_operacion',
			    'public detalle_operacion'[cantidad] *
			    ('public detalle_operacion'[precio_unitario] - 'public detalle_operacion'[descuento])
			)
		lineageTag: 4c3c4a1f-84f3-46d0-80b0-2d67cbb19349

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importe completado' =
			
			CALCULATE(
			    [Importe neto],
			    'public operaciones'[estado] = "completada"
			)
		lineageTag: 4d0b8756-1079-4a98-84d4-c59bc9a64add

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column producto_id
		dataType: int64
		formatString: 0
		lineageTag: ca06950b-b987-4dea-a74e-3421549d9022
		summarizeBy: none
		sourceColumn: producto_id

